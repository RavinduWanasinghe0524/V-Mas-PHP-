# Copy this file to .env and fill in your values
# DO NOT commit .env to GitHub — only commit .env.example

# Local development: use the Vite proxy to the PHP server on port 8000.
VITE_API_BASE_URL=/api

# Production: set this to the deployed PHP API URL before building the frontend.
# VITE_API_BASE_URL=https://your-php-api.example.com/api
